[debug] [2026-06-16T13:42:03.038Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-no-project:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Helper rules\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n    \n    function isAdmin() {\n      return isAuthenticated() && \n        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';\n    }\n\n    // Users collection rules\n    match /users/{userId} {\n      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());\n      \n      // Prevent users from setting role to ADMIN during registration and validate structure\n      allow create: if isAuthenticated() && isOwner(userId) && \n        request.resource.data.role == 'USER' &&\n        request.resource.data.email is string &&\n        request.resource.data.name is string;\n        \n      // Prevent users from upgrading their role to ADMIN\n      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && \n        (request.resource.data.role == resource.data.role || isAdmin()) &&\n        request.resource.data.name is string;\n        \n      allow delete: if isAdmin();\n\n      // Nested collection for verification codes/OTPs\n      match /verification_codes/{codeId} {\n        allow read, write: if isAuthenticated() && isOwner(userId) &&\n          request.resource.data.code is string &&\n          request.resource.data.expiresAt is timestamp &&\n          request.resource.data.used is bool;\n      }\n    }\n\n    // Movies, Cinemas, Showtimes, Promotions: Read by everyone, write by Admin only\n    match /movies/{movieId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /cinemas/{cinemaId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /showtimes/{showtimeId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /promotions/{code} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Bookings collection: Disable client-side writes. Only Cloud Functions can write.\n    match /bookings/{bookingId} {\n      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());\n      allow write: if false;\n    }\n\n    // Booking Seats collection: Disable client-side writes. Only Cloud Functions can write.\n    match /booking_seats/{seatId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    // Tickets collection: Disable client-side writes. Only Cloud Functions can write.\n    match /tickets/{ticketId} {\n      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());\n      allow write: if false;\n    }\n\n    // Payments collection: Disable client-side writes. Only Cloud Functions can write.\n    match /payments/{paymentId} {\n      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());\n      allow write: if false;\n    }\n\n    // Security alerts and Login history: Only authenticated users can read/create their own records\n    match /security_alerts/{alertId} {\n      allow read, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());\n      allow create: if isAuthenticated() && \n        request.resource.data.userId == request.auth.uid &&\n        request.resource.data.type is string &&\n        request.resource.data.severity is string;\n    }\n\n    match /login_history/{historyId} {\n      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());\n      allow create: if isAuthenticated() && \n        request.resource.data.userId == request.auth.uid &&\n        request.resource.data.success is bool &&\n        request.resource.data.deviceName is string;\n      allow update, delete: if false;\n    }\n  }\n}\n"}]}}
