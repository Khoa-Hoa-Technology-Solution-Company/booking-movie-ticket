# ==================================================
# Account Security System - Environment Variables
# Copy this file to .env and fill in your values
# ==================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MySQL via Docker) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://app_user:app_password@localhost:3308/account_security_db"

# --- JWT Secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_here_change_this
JWT_REFRESH_SECRET=your_refresh_token_secret_here_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Gmail SMTP) ---
# To get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords
# 4. Generate a new app password for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Account Security <your_email@gmail.com>"

# --- Security ---
# Max failed login attempts before account lockout
MAX_FAILED_ATTEMPTS=5
# Account lockout duration in minutes
LOCKOUT_DURATION_MINUTES=5
# Verification code expiry in minutes
EMAIL_CODE_EXPIRY_MINUTES=10
# OTP expiry in minutes
OTP_EXPIRY_MINUTES=5
# Resend cooldown in seconds
RESEND_COOLDOWN_SECONDS=60
