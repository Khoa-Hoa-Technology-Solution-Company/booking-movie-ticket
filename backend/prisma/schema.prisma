// ============================================================
// Movie Ticket Booking App with Account Security
// Prisma Schema - MySQL 8.0
// ============================================================
// Gồm 2 phần:
//   1. Account Security: users, verification_codes, refresh_tokens,
//      login_history, security_alerts
//   2. Movie Booking: movies, cinemas, rooms, seats, showtimes,
//      bookings, booking_seats, tickets, payments, promotions
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Role {
  USER
  ADMIN
}

enum VerificationCodeType {
  EMAIL_VERIFY
  PHONE_VERIFY
  OTP_LOGIN
  PASSWORD_RESET
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MovieStatus {
  COMING_SOON
  NOW_SHOWING
  ENDED
}

enum SeatType {
  STANDARD
  VIP
  COUPLE
}

enum SeatStatus {
  AVAILABLE
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  E_WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

// ===================== ACCOUNT SECURITY =====================

/// Bảng users - thông tin tài khoản người dùng
model User {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(100)
  email               String?   @unique @db.VarChar(255)
  phoneNumber         String?   @unique @map("phone_number") @db.VarChar(20)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  emailVerified       Boolean   @default(false) @map("email_verified")
  phoneVerified       Boolean   @default(false) @map("phone_verified")
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  role                Role      @default(USER)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Security relations
  verificationCodes VerificationCode[]
  refreshTokens     RefreshToken[]
  loginHistory      LoginHistory[]
  securityAlerts    SecurityAlert[]

  // Booking relations (cho module đặt vé sau này)
  bookings Booking[]

  @@map("users")
}

/// Bảng verification_codes - mã xác minh email / OTP
model VerificationCode {
  id        Int                  @id @default(autoincrement())
  userId    Int                  @map("user_id")
  codeHash  String               @map("code_hash") @db.VarChar(255)
  type      VerificationCodeType
  expiresAt DateTime             @map("expires_at")
  used      Boolean              @default(false)
  attempts  Int                  @default(0)
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_codes")
}

/// Bảng refresh_tokens - lưu refresh token dạng hash
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// Bảng login_history - lịch sử đăng nhập
model LoginHistory {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  email      String?  @db.VarChar(255)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  deviceName String?  @map("device_name") @db.VarChar(255)
  success    Boolean
  reason     String?  @db.VarChar(255)
  suspicious Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("login_history")
}

/// Bảng security_alerts - cảnh báo bảo mật
model SecurityAlert {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  type      String        @db.VarChar(50)
  message   String        @db.VarChar(500)
  severity  AlertSeverity @default(MEDIUM)
  read      Boolean       @default(false)
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("security_alerts")
}

// ===================== MOVIE BOOKING =====================

/// Bảng movies - thông tin phim
model Movie {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(255)
  description String      @db.Text
  posterUrl   String      @map("poster_url") @db.VarChar(500)
  trailerUrl  String?     @map("trailer_url") @db.VarChar(500)
  duration    Int         // Thời lượng phim (phút)
  ageRating   String      @map("age_rating") @db.VarChar(10) // P, C13, C16, C18
  genre       String      @db.VarChar(255) // "Action, Sci-Fi"
  director    String?     @db.VarChar(255)
  cast        String?     @db.Text
  releaseDate DateTime    @map("release_date")
  status      MovieStatus @default(NOW_SHOWING)
  rating      Float?      @default(0) // Điểm đánh giá 0-10
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  showtimes Showtime[]

  @@map("movies")
}

/// Bảng cinemas - rạp chiếu phim
model Cinema {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  address   String   @db.VarChar(500)
  city      String   @db.VarChar(100)
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms Room[]

  @@map("cinemas")
}

/// Bảng rooms - phòng chiếu
model Room {
  id         Int      @id @default(autoincrement())
  cinemaId   Int      @map("cinema_id")
  name       String   @db.VarChar(50) // "Room 1", "IMAX"
  totalSeats Int      @map("total_seats")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cinema    Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats     Seat[]
  showtimes Showtime[]

  @@map("rooms")
}

/// Bảng seats - ghế trong phòng chiếu
model Seat {
  id     Int        @id @default(autoincrement())
  roomId Int        @map("room_id")
  row    String     @db.VarChar(5) // "A", "B", "C"
  number Int        // 1, 2, 3...
  type   SeatType   @default(STANDARD)
  status SeatStatus @default(AVAILABLE)

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@unique([roomId, row, number])
  @@map("seats")
}

/// Bảng showtimes - lịch chiếu
model Showtime {
  id        Int      @id @default(autoincrement())
  movieId   Int      @map("movie_id")
  roomId    Int      @map("room_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  price     Float    // Giá vé cơ bản (VND)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movie    Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([movieId])
  @@index([roomId])
  @@index([startTime])
  @@map("showtimes")
}

/// Bảng bookings - đơn đặt vé
model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  showtimeId  Int           @map("showtime_id")
  status      BookingStatus @default(PENDING)
  totalAmount Float         @map("total_amount")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtime     Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]
  tickets      Ticket[]
  payment      Payment?

  @@index([userId])
  @@index([showtimeId])
  @@map("bookings")
}

/// Bảng booking_seats - ghế đã đặt trong đơn
model BookingSeat {
  id        Int @id @default(autoincrement())
  bookingId Int @map("booking_id")
  seatId    Int @map("seat_id")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatId])
  @@map("booking_seats")
}

/// Bảng tickets - vé đã xuất
model Ticket {
  id         Int          @id @default(autoincrement())
  bookingId  Int          @map("booking_id")
  ticketCode String       @unique @map("ticket_code") @db.VarChar(20)
  qrCode     String?      @map("qr_code") @db.Text
  status     TicketStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

/// Bảng payments - thanh toán
model Payment {
  id              Int           @id @default(autoincrement())
  bookingId       Int           @unique @map("booking_id")
  method          PaymentMethod @default(CASH)
  amount          Float
  status          PaymentStatus @default(PENDING)
  transactionCode String?       @unique @map("transaction_code") @db.VarChar(50)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

/// Bảng promotions - khuyến mãi
model Promotion {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  discountPercent Int      @map("discount_percent")
  maxDiscount     Float?   @map("max_discount") // Giảm tối đa (VND)
  minPurchase     Float?   @map("min_purchase") // Đơn tối thiểu (VND)
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  active          Boolean  @default(true)
  usageLimit      Int?     @map("usage_limit")
  usageCount      Int      @default(0) @map("usage_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("promotions")
}
